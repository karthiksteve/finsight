# Local LM Studio server (OpenAI-compatible API)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=qwen3-8b
LLM_PROVIDER=lmstudio

# Optional cloud integrations. Leave empty for local-only operation.
GOOGLE_API_KEY=
GROQ_API_KEY=

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Model paths (optional, defaults to ./models/ner_model/model-best)
NER_MODEL_PATH=./models/ner_model/model-best
