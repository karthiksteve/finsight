# ===================================================
# FinSight AI - Environment Configuration
# ===================================================

# ---------------------------------------------------
# PATH A: 100% Local & Free Mode (LM Studio)
# ---------------------------------------------------
# Run LM Studio on your machine and start the local server (default: port 1234)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=qwen3-8b

# Local-first provider selection. Cloud providers are never used unless selected explicitly.
# Use 'gemma-3-4b' here if you prefer lower latency over Qwen's extraction quality.
LLM_PROVIDER=lmstudio

# ---------------------------------------------------
# PATH B: Optional Cloud AI Keys (Leave blank for 100% Local Mode)
# ---------------------------------------------------
# Google Gemini API key (Free at https://aistudio.google.com/)
GOOGLE_API_KEY=

# Groq API key (Free at https://console.groq.com/)
GROQ_API_KEY=

# Pinecone API key (Optional - in-memory local vector store is used by default)
PINECONE_API_KEY=

# ---------------------------------------------------
# Server & Model Settings
# ---------------------------------------------------
HOST=0.0.0.0
PORT=8001
NER_MODEL_PATH=./models/ner_model/model-best
FINBERT_MODEL=ProsusAI/finbert
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
